{
	"name": "example-vite-react-spa-wk",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.7.0",
	"engines": {
		"node": "24"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "oxlint --deny-warnings .",
		"lint:fix": "oxlint --deny-warnings . --fix",
		"fmt": "oxfmt --write src/",
		"fmt:check": "oxfmt --check src/",
		"preview": "pnpm run build && vite preview",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/react-router": "1.170.27",
		"@tanstack/router-devtools": "1.167.1",
		"@tanstack/router-vite-plugin": "1.167.30",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwindcss": "4.3.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.52.1",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.2",
		"@testing-library/user-event": "14.6.4",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.4",
		"@vitejs/plugin-react-swc": "4.3.3",
		"@vitest/ui": "4.1.10",
		"jsdom": "30.0.1",
		"oxfmt": "0.63.0",
		"oxlint": "1.78.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "7.0.2",
		"vite": "8.2.1",
		"vitest": "4.1.10",
		"wrangler": "4.122.0"
	}
}
